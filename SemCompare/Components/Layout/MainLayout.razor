@inherits LayoutComponentBase
@inject AuthStateService AuthState
@inject NavigationManager Nav

<div class="layout">
    <aside class="sidebar">
        <div class="sidebar-logo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/>
            </svg>
            <span>SemCompare</span>
        </div>

        <div class="nav-group-label">Tools</div>
        <nav>
            <NavLink href="/" Match="NavLinkMatch.All">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                <span>Analyser</span>
            </NavLink>
            <NavLink href="/history">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
                <span>History</span>
            </NavLink>
            <NavLink href="/dashboard">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                <span>Dashboard</span>
            </NavLink>
        </nav>

        @if (currentUser != null)
        {
            <div class="sidebar-user">
                @if (!string.IsNullOrEmpty(currentUser.AvatarUrl))
                {
                    <img src="@currentUser.AvatarUrl" alt="avatar" class="avatar" />
                }
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">@currentUser.DisplayName</div>
                    <div class="sidebar-user-login">@@currentUser.Login</div>
                </div>
                <a href="/logout" data-enhance-nav="false" class="btn-icon" title="Sign out" style="margin-left:auto">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </a>
            </div>
        }
        else
        {
            <div style="margin-top:auto; padding: 16px 8px;">
                <a href="/login?switchAccount=true" data-enhance-nav="false" class="btn btn-primary" style="width:100%; justify-content:center; text-decoration:none">
                    Sign in with GitHub
                </a>
            </div>
        }
    </aside>

    <main class="main">
        @if (!AuthState.IsAuthenticated)
        {
            <div class="login-gate">
                <div class="login-card">
                    <div class="login-logo">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/>
                        </svg>
                    </div>
                    <h1 class="login-title">SemCompare</h1>
                    <p class="login-sub">Understand what actually changed in your C# code — beyond line diffs.</p>
                    <a href="/login?switchAccount=true" data-enhance-nav="false" class="btn btn-primary btn-lg">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                        </svg>
                        Sign in with GitHub
                    </a>
                    <p class="login-note">Requires repo scope to access private repositories.</p>
                </div>
            </div>
        }
        else
        {
            @Body
        }
    </main>
</div>

@code {
    SemCompare.Models.AppUser? currentUser;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthState.GetCurrentUserAsync();
    }
}
